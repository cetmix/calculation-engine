<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="base_calculation_block_view_tree" model="ir.ui.view">
        <field name="name">base.calculation.block.view.tree</field>
        <field name="model">base.calculation.block</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="reference" />
            </tree>
        </field>
    </record>

    <record id="base_calculation_block_view_form" model="ir.ui.view">
        <field name="name">base.calculation.block.view.form</field>
        <field name="model">base.calculation.block</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_related_calculations"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calculator"
                            attrs="{'invisible': [('calculation_count', '=', 0)]}"
                        >
                            <field
                                string="Calculations"
                                name="calculation_count"
                                widget="statinfo"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                      <label for="name" string="Calculation Block Name" />
                      <h1><field
                                name="name"
                                placeholder="e.g. Apply Sales Order Discount"
                            /></h1>
                    </div>
                    <group>
                        <field name="reference" placeholder="e.g. APPLY_DISCOUNT" />
                    </group>
                    <notebook>
                        <page string="Python Expression" name="python_expression">
                            <field
                                name="expression"
                                widget="ace"
                                options="{'mode': 'python'}"
                                nolabel="1"
                            />
                        </page>
                        <page string="Help" name="help_info">
                            <div style="margin-top: 4px;">
                                <h3>Help with Python expressions</h3>
                                <p
                                >Various fields may use Python code or Python expressions. The following variables can be used:</p>
                                <ul>
                                    <li><code
                                        >env</code>: Odoo Environment on which the calculation is triggered</li>
                                    <li><code
                                        >model</code>: Odoo Model of the record on which the calulation is triggered; is a void recordset</li>
                                    <li><code
                                        >record</code>: record on which the calculation is triggered; may be be void</li>
                                    <li><code
                                        >records</code>: recordset of all records on which the calculation is triggered in multi mode; may be void</li>
                                    <li><code>time</code>, <code>datetime</code>, <code
                                        >dateutil</code>, <code
                                        >timezone</code>: useful Python libraries</li>
                                    <li><code
                                        >log(message, level='info')</code>: logging function to record debug information in <code
                                        >ir.logging</code> table</li>
                                    <li><code
                                        >UserError</code>: Warning Exception to use with <code
                                        >raise</code></li>
                                    <li><code
                                        >Command</code>: x2Many commands namespace</li>
                                    <li>To return a RESULT, assign: <code
                                        >RESULT["key_name"] = ...</code></li>
                                </ul>
                                <div>
                                    <p>Example of Python code</p>
                                    <code style='white-space: pre-wrap'>
                                    discount_multiplier = (100-DISCOUNT_PERCENT)/100<br
                                        />
                                    RESULT["final_price"] = SALE_TOTAL * discount_multiplier
                                    </code>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="base_calculation_block_search_view" model="ir.ui.view">
        <field name="name">base.calculation.block.view.search</field>
        <field name="model">base.calculation.block</field>
        <field name="arch" type="xml">
            <search string="Base Calculation Variable">
                <field name="name" />
                <field name="reference" />
            </search>
        </field>
    </record>


    <record id="action_base_calculation_block" model="ir.actions.act_window">
        <field name="name">Calculation Blocks</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">base.calculation.block</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="base_calculation_block_search_view" />
    </record>

    <menuitem
        id="menu_base_calculation_block_form"
        parent="base_calculation.menu_base_calculation"
        action="base_calculation.action_base_calculation_block"
        sequence="1"
    />
</odoo>
