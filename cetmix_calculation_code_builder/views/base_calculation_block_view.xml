<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="base_calculation_block_code_builder_view_form" model="ir.ui.view">
        <field name="name">base.calculation.block.code.builder.view.form</field>
        <field name="model">base.calculation.block</field>
        <field
            name="inherit_id"
            ref="cetmix_calculation.base_calculation_block_view_form"
        />
        <field name="arch" type="xml">
            <field name="reference" position="after">
                <field name="use_expressions" />
            </field>
            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <div
                    class="alert alert-warning alert-dismissible fade show text-center"
                    role="alert"
                    colspan="2"
                    name="caption"
                    attrs="{'invisible': [('use_expressions', '=', False)]}"
                >
                    Caution! Existing python expression will be automatically overwritten with the code generated by Expression Builder.
                </div>
            </xpath>
            <xpath expr="//page[@name='python_expression']" position="before">
                <page
                    string="Expression Builder"
                    name="expression_builder"
                    attrs="{'invisible': [('use_expressions', '=', False)]}"
                >
                    <field name="expression_ids" />
                </page>
            </xpath>
            <xpath
                expr="//page[@name='python_expression']/field[@name='expression']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'readonly': [('use_expressions', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
