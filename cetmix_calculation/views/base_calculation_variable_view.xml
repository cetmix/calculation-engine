<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="base_calculation_variable_view_tree" model="ir.ui.view">
        <field name="name">base.calculation.variable.view.tree</field>
        <field name="model">base.calculation.variable</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="note" />
            </tree>
        </field>
    </record>

    <record id="base_calculation_variable_view_form" model="ir.ui.view">
        <field name="name">base.calculation.variable.view.form</field>
        <field name="model">base.calculation.variable</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="note" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="base_calculation_variable_search_view" model="ir.ui.view">
        <field name="name">base.calculation.variable.view.search</field>
        <field name="model">base.calculation.variable</field>
        <field name="arch" type="xml">
            <search string="Base Calculation Variable">
                <field name="name" />
                <field name="note" />
            </search>
        </field>
    </record>


    <record id="action_base_calculation_variable" model="ir.actions.act_window">
        <field name="name">Calculation Variables</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">base.calculation.variable</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="base_calculation_variable_search_view" />
    </record>

    <menuitem
        id="menu_base_calculation_variable_form"
        parent="cetmix_calculation.menu_base_calculation"
        action="cetmix_calculation.action_base_calculation_variable"
        sequence="2"
    />
</odoo>
